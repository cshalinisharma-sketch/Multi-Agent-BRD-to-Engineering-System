    "Flag": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ambiguity",
            "contradiction",
            "missing_section",
            "feasibility",
            "injection",
            "pii",
            "scope"
          ],
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "brd_refs": {
          "items": {
            "type": "string"
          },
          "title": "Brd Refs",
          "type": "array"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Conservative default applied, if any",
          "title": "Resolution"
        }
      },
      "required": [
        "id",
        "kind",
        "severity",
        "message"
      ],
      "title": "Flag",
      "type": "object"
    },
