            "type": "string"
          },
          "title": "Brd Refs",
          "type": "array"
        },
        "citations": {
          "description": "chunk_ids retrieved from the knowledge base",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "assumption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Documented assumption when the BRD is silent/ambiguous",
          "title": "Assumption"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "responsibility": {
          "title": "Responsibility",
          "type": "string"
        },
        "category": {
          "enum": [
            "frontend",
            "api",
            "service",
            "worker",
            "database",
            "cache",
            "messaging",
            "stream-processing",
            "search",
            "integration",
            "auth",
            "observability",
            "storage",
            "analytics"
